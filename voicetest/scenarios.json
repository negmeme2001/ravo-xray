{
  "version": 1,
  "notes": "Realistic kiosk speech. Clips are recorded by a person and kept outside the repo; audio fields (sha256, duration_s, sample_rate) are filled by `python -m voicetest.manifest`. Keywords: every inner list is one idea, any variant counts. Expected types are catalog product types (name without brand).",
  "scenarios": [
    {"id": "01", "clip": "01", "language": "en", "kind": "clear",
     "reference": "Do you have oat milk?",
     "keywords": [["oat", "اوت"], ["milk", "ملك", "لبن"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": ["Oat Milk"]}},
    {"id": "02", "clip": "02", "language": "ar", "kind": "clear",
     "reference": "عندكم لبن شوفان؟",
     "keywords": [["عندكم", "عندكو"], ["لبن", "milk"], ["شوفان", "oat"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": ["Oat Milk"]}},
    {"id": "03", "clip": "03", "language": "mixed", "kind": "clear",
     "reference": "عايز حاجة للـ headache",
     "keywords": [["عايز", "عاوز"], ["حاجه"], ["headache", "هيداك", "صداع"]],
     "expect": {"should_answer": true, "should_clarify": false,
                "expected_types": ["Headache Relief Gel", "Paracetamol Tablets", "Ibuprofen Tablets", "Aspirin", "Migraine Relief Caplets"]}},
    {"id": "04", "clip": "04", "language": "mixed", "kind": "clear",
     "reference": "Do you have حاجة للبرد؟",
     "keywords": [["have", "هاف"], ["حاجه"], ["برد", "cold"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": ["Cold & Flu Powder", "Paracetamol Tablets"]}},
    {"id": "05", "clip": "05", "language": "en", "kind": "pause-mid-sentence",
     "reference": "I'm looking for something for back pain",
     "keywords": [["looking"], ["back"], ["pain"]],
     "expect": {"should_answer": true, "should_clarify": false,
                "expected_types": ["Muscle Rub Cream", "Ibuprofen Tablets", "Paracetamol Tablets", "Aspirin"]}},
    {"id": "06", "clip": "06", "language": "ar", "kind": "pause-mid-sentence",
     "reference": "كنت عايز حاجة للبرد",
     "keywords": [["عايز", "عاوز"], ["حاجه"], ["برد"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": ["Cold & Flu Powder", "Paracetamol Tablets"]}},
    {"id": "07", "clip": "07", "language": "mixed", "kind": "filler-only",
     "reference": "umm يعني",
     "keywords": [],
     "expect": {"should_answer": false, "should_clarify": true, "expected_types": []}},
    {"id": "08", "clip": "08", "language": "en", "kind": "unfinished",
     "reference": "Do you have the",
     "keywords": [["have"]],
     "expect": {"should_answer": false, "should_clarify": true, "expected_types": []}},
    {"id": "09", "clip": "09", "language": "ar", "kind": "not-sold",
     "reference": "عندكم لابتوب؟",
     "keywords": [["عندكم", "عندكو"], ["لابتوب", "laptop"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": []}},
    {"id": "10", "clip": "10", "language": "mixed", "kind": "policy",
     "reference": "ممكن أرجع الـ laptop لو فتحته؟",
     "keywords": [["ارجع"], ["laptop", "لابتوب"], ["فتحته"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": []}},
    {"id": "11", "clip": "11", "language": "en", "kind": "random-start",
     "reference": "banana table do you have milk?",
     "keywords": [["milk", "لبن"]],
     "expect": {"should_answer": true, "should_clarify": false,
                "expected_types": ["Whole Milk", "Skimmed Milk", "Oat Milk", "Soy Milk", "Almond Milk"]}},
    {"id": "12", "clip": "12", "language": "ar", "kind": "gibberish",
     "reference": "شباك أزرق كرسي",
     "keywords": [["شباك"], ["ازرق"], ["كرسي"]],
     "expect": {"should_answer": false, "should_clarify": true, "expected_types": []}},
    {"id": "13", "clip": "13", "language": "en", "kind": "background-noise",
     "reference": "Do you have oat milk?",
     "keywords": [["oat", "اوت"], ["milk", "ملك", "لبن"]],
     "expect": {"should_answer": true, "should_clarify": false, "expected_types": ["Oat Milk"]}}
  ]
}
